{
  "_description": "Juniper Ridge Example Co, a fictional distributor, runs SailPoint Identity Security Cloud with four sources: Active Directory (direct connector), a Finance ERP (Web Services connector), a Badge System handled through a ServiceNow service desk integration, and a read-only Legacy Payroll flat file. Twelve changes from today's identity refresh and access requests need a provisioning plan. Each change is planned against this starting snapshot.",
  "sources": {
    "Active Directory": {
      "connector": "Active Directory",
      "provisioning": true,
      "owner": "it-identity@juniperridge.example",
      "create_policy": [
        {
          "name": "sAMAccountName",
          "type": "generator",
          "generator": "unique_username",
          "pattern": "$(firstname).$(lastname)$(uniqueCounter)",
          "max_uniqueness_checks": 5,
          "required": true
        },
        {
          "name": "mail",
          "type": "identityAttribute",
          "attribute": "email",
          "required": true
        },
        {
          "name": "department",
          "type": "identityAttribute",
          "attribute": "department",
          "required": true
        },
        {
          "name": "description",
          "type": "static",
          "value": "Provisioned by Identity Security Cloud"
        },
        {
          "name": "password",
          "type": "generator",
          "generator": "password",
          "required": true
        }
      ],
      "existing_usernames": [
        "maria.lopez",
        "maria.lopez1",
        "raj.patel",
        "dana.kim",
        "ivan.novak",
        "adm-ivan.novak",
        "grace.chen",
        "tom.reyes"
      ],
      "attribute_sync": {
        "department": "department",
        "title": "title"
      }
    },
    "Finance ERP": {
      "connector": "Web Services",
      "provisioning": true,
      "owner": "erp-admins@juniperridge.example",
      "create_policy": [
        {
          "name": "userName",
          "type": "identityAttribute",
          "attribute": "email",
          "required": true
        },
        {
          "name": "costCenter",
          "type": "identityAttribute",
          "attribute": "costCenter",
          "required": true
        },
        {
          "name": "userType",
          "type": "static",
          "value": "EMPLOYEE",
          "required": true
        }
      ],
      "attribute_sync": {
        "department": "dept"
      }
    },
    "Badge System": {
      "connector": "Delimited File",
      "provisioning": false,
      "service_desk": "ServiceNow Service Desk",
      "owner": "facilities@juniperridge.example",
      "create_policy": [
        {
          "name": "badgeHolder",
          "type": "identityAttribute",
          "attribute": "displayName",
          "required": true
        },
        {
          "name": "site",
          "type": "static",
          "value": "HQ"
        }
      ],
      "attribute_sync": {
        "title": "title"
      }
    },
    "Legacy Payroll": {
      "connector": "Delimited File",
      "provisioning": false,
      "read_only": true,
      "owner": "payroll-lead@juniperridge.example",
      "create_policy": [
        {
          "name": "employeeId",
          "type": "identityAttribute",
          "attribute": "employeeNumber",
          "required": true
        }
      ],
      "attribute_sync": {
        "title": "jobTitle"
      }
    }
  },
  "access_profiles": {
    "AP-AD-Finance": {
      "source": "Active Directory",
      "entitlements": [
        "CN=Finance-Share",
        "CN=VPN-Users"
      ],
      "requestable": false
    },
    "AP-AD-Sales": {
      "source": "Active Directory",
      "entitlements": [
        "CN=Sales-Team",
        "CN=VPN-Users"
      ],
      "requestable": false
    },
    "AP-AD-VPN": {
      "source": "Active Directory",
      "entitlements": [
        "CN=VPN-Users"
      ],
      "requestable": true
    },
    "AP-ERP-AP-Clerk": {
      "source": "Finance ERP",
      "entitlements": [
        "AP Invoice Entry"
      ],
      "requestable": false
    },
    "AP-ERP-Approver": {
      "source": "Finance ERP",
      "entitlements": [
        "Invoice Approver"
      ],
      "requestable": true
    },
    "AP-Badge-HQ": {
      "source": "Badge System",
      "entitlements": [
        "HQ Floor 3"
      ],
      "requestable": true
    },
    "AP-Payroll-View": {
      "source": "Legacy Payroll",
      "entitlements": [
        "Payroll Read"
      ],
      "requestable": false
    },
    "AP-Old-CRM": {
      "source": "Old CRM",
      "entitlements": [
        "CRM User"
      ],
      "requestable": true
    }
  },
  "roles": {
    "Finance Analyst": {
      "criteria": [
        {
          "attribute": "department",
          "equals": "Finance"
        }
      ],
      "requestable": false,
      "access_profiles": [
        "AP-AD-Finance",
        "AP-ERP-AP-Clerk",
        "AP-Payroll-View"
      ]
    },
    "Sales Rep": {
      "criteria": [
        {
          "attribute": "department",
          "equals": "Sales"
        }
      ],
      "requestable": false,
      "access_profiles": [
        "AP-AD-Sales",
        "AP-Badge-HQ"
      ]
    },
    "Facilities Access": {
      "criteria": [],
      "requestable": true,
      "access_profiles": [
        "AP-Badge-HQ"
      ]
    }
  },
