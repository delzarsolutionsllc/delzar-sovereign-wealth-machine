  "group_rules": [
    {
      "id": "R01",
      "name": "Sales US",
      "status": "ACTIVE",
      "expression": "user.department == \"Sales\" AND user.countryCode == \"US\"",
      "assign_to": [
        "00g-sales-us"
      ],
      "exclude": [
        "frank.cole@harrowgate.example"
      ]
    },
    {
      "id": "R02",
      "name": "Leadership",
      "status": "ACTIVE",
      "expression": "String.startsWith(user.title, \"VP\") OR user.title == \"Chief Executive Officer\"",
      "assign_to": [
        "00g-leadership"
      ],
      "exclude": []
    },
    {
      "id": "R03",
      "name": "All employees",
      "status": "ACTIVE",
      "expression": "user.employeeType != \"Contractor\"",
      "assign_to": [
        "00g-employees"
      ],
      "exclude": []
    },
    {
      "id": "R04",
      "name": "Remote staff",
      "status": "INACTIVE",
      "expression": "user.remoteWorker == true",
      "assign_to": [
        "00g-remote"
      ],
      "exclude": []
    },
    {
      "id": "R05",
      "name": "PMP holders",
      "status": "ACTIVE",
      "expression": "Arrays.contains(user.certifications, \"PMP\")",
      "assign_to": [
        "00g-pmp"
      ],
      "exclude": []
    },
    {
      "id": "R06",
      "name": "Finance to AD",
      "status": "ACTIVE",
      "expression": "user.department == \"Finance\"",
      "assign_to": [
        "00g-ad-finance"
      ],
      "exclude": []
    },
    {
      "id": "R07",
      "name": "Support team",
      "status": "ACTIVE",
      "expression": "user.department = \"Support\"",
      "assign_to": [
        "00g-support"
      ],
      "exclude": []
    }
  ],
