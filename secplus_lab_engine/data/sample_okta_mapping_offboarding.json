{
  "_description": "Larkspur Example Co (fictional): PeopleHub HR is the profile source for employees, Okta pushes profiles to Expense Portal and Team Chat, and this week's joiners, movers and leavers need their mappings, status changes and offboarding checked.",
  "company": "Larkspur Example Co",
  "okta_schema": {
    "login": "string",
    "email": "string",
    "firstName": "string",
    "lastName": "string",
    "department": "string",
    "title": "string",
    "employeeNumber": "string",
    "costCenter": "string",
    "mobilePhone": "string",
    "isManager": "boolean",
    "managerId": "string"
  },
  "profile_sources": {
    "PeopleHub HR": {
      "okta_owned_attributes": [
        "mobilePhone"
      ],
      "mappings": [
        {
          "target": "login",
          "expression": "String.toLowerCase(appuser.workEmail)",
          "apply": "create_only"
        },
        {
          "target": "email",
          "expression": "String.toLowerCase(appuser.workEmail)",
          "apply": "create_and_update"
        },
        {
          "target": "firstName",
          "expression": "appuser.givenName",
          "apply": "create_and_update"
        },
        {
          "target": "lastName",
          "expression": "appuser.familyName",
          "apply": "create_and_update"
        },
        {
          "target": "department",
          "expression": "appuser.dept != null ? appuser.dept : \"Unassigned\"",
          "apply": "create_and_update"
        },
        {
          "target": "title",
          "expression": "appuser.jobTitle",
          "apply": "create_and_update"
        },
        {
          "target": "employeeNumber",
          "expression": "appuser.empId",
          "apply": "create_and_update"
        },
        {
          "target": "isManager",
          "expression": "appuser.isPeopleManager",
          "apply": "create_and_update"
        },
        {
          "target": "mobilePhone",
          "expression": "appuser.mobile",
          "apply": "create_and_update"
        }
      ]
    }
  },
  "apps": {
    "Expense Portal": {
      "sso": "SAML",
      "local_login": false,
      "provisioning": {
        "create_users": true,
        "update_attributes": true,
        "deactivate_users": true
      },
      "schema": {
        "userName": "string",
        "email": "string",
        "displayName": "string",
        "department": "string",
        "costCenter": "string",
        "approver": "boolean"
      },
      "mappings": [
        {
          "target": "userName",
          "expression": "user.login",
          "apply": "create_and_update"
        },
        {
          "target": "email",
          "expression": "user.email",
          "apply": "create_and_update"
        },
        {
          "target": "displayName",
          "expression": "user.firstName + \" \" + user.lastName",
          "apply": "create_and_update"
        },
        {
          "target": "department",
          "expression": "user.department",
          "apply": "create_and_update"
        },
        {
          "target": "costCenter",
          "expression": "user.costCenter != null ? user.costCenter : \"CC-000\"",
          "apply": "create_and_update"
        },
        {
          "target": "approver",
          "expression": "user.isManager",
          "apply": "create_and_update"
        }
      ]
    },
    "Team Chat": {
      "sso": "OIDC",
      "local_login": false,
      "provisioning": {
        "create_users": true,
        "update_attributes": true,
        "deactivate_users": false
      },
      "schema": {
        "handle": "string",
        "email": "string",
        "jobTitle": "string",
        "manager": "string"
      },
      "mappings": [
        {
          "target": "handle",
          "expression": "String.toLowerCase(user.firstName + \".\" + user.lastName)",
          "apply": "create_only"
        },
        {
          "target": "email",
          "expression": "user.email",
          "apply": "create_and_update"
        },
        {
          "target": "jobTitle",
          "expression": "user.title",
          "apply": "create_only"
        },
        {
          "target": "manager",
          "expression": "user.managerId",
          "apply": "create_and_update"
        }
      ]
    },
    "Vendor Wiki": {
      "sso": "SWA",
      "local_login": true,
      "provisioning": {}
    },
    "Legacy CRM": {
      "sso": "SAML",
      "local_login": true,
      "provisioning": {}
    },
    "Analytics Hub": {
      "sso": "SAML",
      "local_login": false,
      "provisioning": {}
    },
    "Benefits Link": {
      "sso": "BOOKMARK",
      "provisioning": {}
    }
  },
