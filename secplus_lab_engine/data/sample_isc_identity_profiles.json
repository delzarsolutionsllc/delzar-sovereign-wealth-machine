{
  "_description": "Cobalt Ridge Example Ltd (fictional) is onboarding its HR sources into SailPoint Identity Security Cloud: employees from a Workday-style HR system, contractors from a CSV file, interns from a tracker spreadsheet and an old payroll database that is not authoritative. Three identity profiles, 16 accounts and 7 transform tests to check before go-live.",
  "sources": [
    {
      "name": "Workday HR",
      "type": "HR (Workday-style)",
      "correlation_attribute": "WORK_EMAIL"
    },
    {
      "name": "Contractor CSV",
      "type": "Delimited file",
      "correlation_attribute": "email"
    },
    {
      "name": "Intern Tracker",
      "type": "Delimited file",
      "correlation_attribute": "email"
    },
    {
      "name": "Legacy Payroll",
      "type": "JDBC (not authoritative)",
      "correlation_attribute": "email"
    },
    {
      "name": "Corp AD",
      "type": "Active Directory",
      "correlation_attribute": "mail"
    }
  ],
  "identity_profiles": [
    {
      "name": "Contractors",
      "authoritative_source": "Contractor CSV",
      "priority": 20,
      "sign_in": {
        "method": "USERNAME_PASSWORD",
        "block_access_from": [
          "off_network"
        ],
        "network_ranges": []
      },
      "lifecycle_states": [
        "active",
        "inactive"
      ],
      "mappings": {
        "uid": {
          "source": "Contractor CSV",
          "attribute": "contractor_id",
          "transform": {
            "type": "lower",
            "attributes": {
              "input": {
                "type": "replace",
                "attributes": {
                  "regex": "[^A-Za-z0-9]",
                  "replacement": ""
                }
              }
            }
          }
        },
        "email": {
          "source": "Contractor CSV",
          "attribute": "email",
          "transform": {
            "type": "lower"
          }
        },
        "firstname": {
          "source": "Contractor CSV",
          "attribute": "first_name"
        },
        "lastname": {
          "source": "Contractor CSV",
          "attribute": "last_name"
        },
        "department": {
          "transform": {
            "type": "static",
            "attributes": {
              "value": "Contractor ($vendor)",
              "vendor": {
                "type": "accountAttribute",
                "attributes": {
                  "sourceName": "Contractor CSV",
                  "attributeName": "vendor"
                }
              }
            }
          }
        },
        "endDate": {
          "source": "Contractor CSV",
          "attribute": "end_date",
          "transform": {
            "type": "dateFormat",
            "attributes": {
              "inputFormat": "yyyy-MM-dd",
              "outputFormat": "ISO8601"
            }
          }
        },
        "cloudLifecycleState": {
          "transform": {
            "type": "conditional",
            "attributes": {
              "expression": "$status eq A",
              "positiveCondition": "active",
              "negativeCondition": "inactive",
              "status": {
                "type": "accountAttribute",
                "attributes": {
                  "sourceName": "Contractor CSV",
                  "attributeName": "status"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "Employees",
      "authoritative_source": "Workday HR",
      "priority": 10,
      "sign_in": {
        "method": "DIRECTORY_CONNECTION",
        "authentication_source": "Corp AD"
      },
      "lifecycle_states": [
        "prehire",
        "active",
        "inactive"
      ],
      "mappings": {
        "uid": {
          "transform": {
            "type": "lower",
            "attributes": {
              "input": {
                "type": "concat",
                "attributes": {
                  "values": [
                    {
                      "type": "substring",
                      "attributes": {
                        "begin": 0,
                        "end": 1,
                        "input": {
                          "type": "accountAttribute",
                          "attributes": {
                            "sourceName": "Workday HR",
                            "attributeName": "FIRST_NAME"
                          }
                        }
                      }
                    },
                    {
                      "type": "trim",
                      "attributes": {
                        "input": {
                          "type": "accountAttribute",
                          "attributes": {
                            "sourceName": "Workday HR",
                            "attributeName": "LAST_NAME"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "email": {
          "transform": {
            "type": "firstValid",
            "attributes": {
              "values": [
                {
                  "type": "accountAttribute",
                  "attributes": {
                    "sourceName": "Workday HR",
                    "attributeName": "WORK_EMAIL"
                  }
                },
                {
                  "type": "concat",
                  "attributes": {
                    "values": [
                      {
                        "type": "identityAttribute",
                        "attributes": {
                          "name": "uid"
                        }
                      },
                      "@cobaltridge.example"
                    ]
                  }
                }
              ]
            }
          }
        },
        "firstname": {
          "transform": {
            "type": "firstValid",
            "attributes": {
              "values": [
                {
                  "type": "accountAttribute",
                  "attributes": {
                    "sourceName": "Workday HR",
                    "attributeName": "PREFERRED_NAME"
                  }
                },
                {
                  "type": "accountAttribute",
                  "attributes": {
                    "sourceName": "Workday HR",
                    "attributeName": "FIRST_NAME"
                  }
                }
              ]
            }
          }
        },
        "lastname": {
          "source": "Workday HR",
          "attribute": "LAST_NAME",
          "transform": {
            "type": "trim"
          }
        },
        "department": {
          "source": "Workday HR",
          "attribute": "DEPT_CODE",
          "transform": {
            "type": "lookup",
            "attributes": {
              "table": {
                "FIN": "Finance",
                "ENG": "Engineering",
                "OPS": "Operations",
                "default": "Unassigned"
              }
            }
          }
        },
        "startDate": {
          "source": "Workday HR",
          "attribute": "HIRE_DATE",
          "transform": {
            "type": "dateFormat",
            "attributes": {
              "inputFormat": "PEOPLE_SOFT",
              "outputFormat": "ISO8601"
            }
          }
        },
        "phone": {
          "source": "Workday HR",
          "attribute": "WORK_PHONE",
          "transform": {
            "type": "e164phone",
            "attributes": {
              "defaultRegion": "US"
            }
          }
        },
        "cloudLifecycleState": {
          "source": "Workday HR",
          "attribute": "WORKER_STATUS",
          "transform": {
            "type": "lookup",
            "attributes": {
              "table": {
                "Active": "active",
                "Pre-hire": "prehire",
                "Terminated": "inactive",
                "Leave": "leave"
              }
            }
          }
        }
      }
    },
    {
      "name": "Interns",
      "authoritative_source": "Intern Tracker",
      "priority": 30,
      "sign_in": {
        "method": "DIRECTORY_CONNECTION",
        "authentication_source": "Campus LDAP"
      },
      "lifecycle_states": [
        "active",
        "inactive"
      ],
      "mappings": {
        "uid": {
          "source": "Intern Tracker",
          "attribute": "intern_id",
          "transform": {
            "type": "lower"
          }
        },
        "email": {
          "source": "Intern Tracker",
          "attribute": "email"
        },
        "firstname": {
          "source": "Intern Tracker",
          "attribute": "first_name",
          "transform": {
            "type": "titleCase"
          }
        },
        "lastname": {
          "source": "Intern Tracker",
          "attribute": "last_name"
        },
        "cloudLifecycleState": {
          "transform": {
            "type": "static",
            "attributes": {
              "value": "active"
            }
          }
        }
      }
    }
  ],
