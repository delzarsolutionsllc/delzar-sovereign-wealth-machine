  "transform_tests": [
    {
      "id": "X1",
      "description": "employee number without prefix and leading zeros",
      "transform": {
        "type": "replace",
        "attributes": {
          "regex": "^0+",
          "replacement": "",
          "input": {
            "type": "substring",
            "attributes": {
              "begin": 4
            }
          }
        }
      },
      "input": "EMP-00731"
    },
    {
      "id": "X2",
      "description": "office city, cleaned and upper-case",
      "transform": {
        "type": "upper",
        "attributes": {
          "input": {
            "type": "trim"
          }
        }
      },
      "input": "  Rotterdam "
    },
    {
      "id": "X3",
      "description": "termination check written with ne",
      "transform": {
        "type": "conditional",
        "attributes": {
          "expression": "$s ne T",
          "positiveCondition": "active",
          "negativeCondition": "inactive",
          "s": {
            "type": "static",
            "attributes": {
              "value": "A"
            }
          }
        }
      }
    },
    {
      "id": "X4",
      "description": "first valid of a failing lookup and a static fallback",
      "transform": {
        "type": "firstValid",
        "attributes": {
          "ignoreErrors": true,
          "values": [
            {
              "type": "lookup",
              "attributes": {
                "table": {
                  "NL": "Netherlands"
                }
              }
            },
            {
              "type": "static",
              "attributes": {
                "value": "Unknown country"
              }
            }
          ]
        }
      },
      "input": "PT"
    },
    {
      "id": "X5",
      "description": "contract end date to PeopleSoft format",
      "transform": {
        "type": "dateFormat",
        "attributes": {
          "inputFormat": "yyyy-MM-dd",
          "outputFormat": "PEOPLE_SOFT"
        }
      },
      "input": "2026-03-02"
    },
    {
      "id": "X6",
      "description": "manager uid read before it is calculated",
      "transform": {
        "type": "identityAttribute",
        "attributes": {
          "name": "managerUid"
        }
      },
      "identity": {
        "uid": "jdoe"
      }
    },
    {
      "id": "X7",
      "description": "work phone to E.164",
      "transform": {
        "type": "e164phone"
      },
      "input": "(312) 555-0142"
    }
  ]
