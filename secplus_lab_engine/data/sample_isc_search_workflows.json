  "workflows": [
    {"id": "W01", "name": "Mover: email the identity", "steps": [
      {"name": "Send Email", "type": "Send Email", "next": "End Step - Success", "uses": ["$.getIdentity.email"]},
      {"name": "End Step - Success", "type": "End Step - Success"},
      {"name": "Get Identity", "type": "Get Identity", "next": "Send Email", "uses": ["$.trigger.identity.id"]},
      {"name": "Identity Attributes Changed", "type": "Event Trigger", "trigger": "Identity Attributes Changed", "next": "Get Identity"}]},
    {"id": "W02", "name": "Leaver: remove all access", "steps": [
      {"name": "Manage Access", "type": "Manage Access", "next": "End Step - Success", "uses": ["$.getAccess.accessItems"]},
      {"name": "Compare Strings", "type": "Compare Strings", "true": "Get Access", "false": "End Step - Success", "uses": ["$.getIdentity.attributes.cloudLifecycleState"]},
      {"name": "Identity Attributes Changed", "type": "Event Trigger", "trigger": "Identity Attributes Changed", "next": "Get Identity"},
      {"name": "Get Access", "type": "Get Access", "next": "Manage Access", "uses": ["$.trigger.identity.id"]},
      {"name": "End Step - Success", "type": "End Step - Success"},
      {"name": "Get Identity", "type": "Get Identity", "next": "Compare Strings", "uses": ["$.trigger.identity.id"]}]},
    {"id": "W03", "name": "Department check, half wired", "steps": [
      {"name": "Get Identity", "type": "Get Identity", "next": "Compare Strings", "uses": ["$.trigger.identity.id"]},
      {"name": "Send Email", "type": "Send Email", "next": "End Step - Success", "uses": ["$.getIdentity.email"]},
      {"name": "Identity Created", "type": "Event Trigger", "trigger": "Identity Created", "next": "Get Identity"},
      {"name": "Compare Strings", "type": "Compare Strings", "true": "Send Email", "uses": ["$.getIdentity.attributes.department"]},
      {"name": "End Step - Success", "type": "End Step - Success"}]},
    {"id": "W04", "name": "Welcome email with no end", "steps": [
      {"name": "Send Email", "type": "Send Email", "uses": ["$.getIdentity.email"]},
      {"name": "Identity Created", "type": "Event Trigger", "trigger": "Identity Created", "next": "Get Identity"},
      {"name": "Get Identity", "type": "Get Identity", "next": "Send Email", "uses": ["$.trigger.identity.id"]},
      {"name": "End Step - Success", "type": "End Step - Success"}]},
    {"id": "W05", "name": "Email before the lookup", "steps": [
      {"name": "Get Identity", "type": "Get Identity", "next": "End Step - Success", "uses": ["$.trigger.identity.id"]},
      {"name": "Identity Created", "type": "Event Trigger", "trigger": "Identity Created", "next": "Send Email"},
      {"name": "End Step - Success", "type": "End Step - Success"},
      {"name": "Send Email", "type": "Send Email", "next": "Get Identity", "uses": ["$.getIdentity.email"]}]},
    {"id": "W06", "name": "Two ways to start", "steps": [
      {"name": "Get Identity", "type": "Get Identity", "next": "End Step - Failure", "uses": ["$.trigger.identity.id"]},
      {"name": "Scheduled Trigger", "type": "Scheduled Trigger", "next": "Get Identity"},
      {"name": "End Step - Failure", "type": "End Step - Failure"},
      {"name": "Identity Created", "type": "Event Trigger", "trigger": "Identity Created", "next": "Get Identity"}]},
    {"id": "W07", "name": "Account count alert, variable on one branch", "steps": [
      {"name": "Send Email", "type": "Send Email", "next": "End Step - Success", "uses": ["$.getAccounts.accounts"]},
      {"name": "Get Accounts", "type": "Get Accounts", "next": "Wait", "uses": ["$.trigger.identity.id"]},
      {"name": "Compare Numbers", "type": "Compare Numbers", "true": "Get Accounts", "false": "Send Email", "uses": ["$.getIdentity.accountCount"]},
      {"name": "Wait", "type": "Wait", "next": "Send Email"},
      {"name": "Get Identity", "type": "Get Identity", "next": "Compare Numbers", "uses": ["$.trigger.identity.id"]},
      {"name": "Account Aggregation Completed", "type": "Event Trigger", "trigger": "Account Aggregation Completed", "next": "Get Identity"},
      {"name": "End Step - Success", "type": "End Step - Success"}]},
    {"id": "W08", "name": "Quarterly manager campaign", "steps": [
      {"name": "End Step - Success", "type": "End Step - Success"},
      {"name": "Create Certification Campaign", "type": "Create Certification Campaign", "next": "Send Email"},
      {"name": "Scheduled Trigger", "type": "Scheduled Trigger", "next": "Create Certification Campaign"},
      {"name": "Send Email", "type": "Send Email", "next": "End Step - Success", "uses": ["$.createCertificationCampaign.id"]}]}
