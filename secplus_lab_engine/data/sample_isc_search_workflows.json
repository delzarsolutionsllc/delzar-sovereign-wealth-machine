  "queries": [
    {"id": "Q01", "purpose": "Finance staff in London", "query": "attributes.department:Finance AND attributes.location:London"},
    {"id": "Q02", "purpose": "Leavers whose AD account is still enabled", "query": "attributes.cloudLifecycleState:terminated AND @accounts(source.name:\"Active Directory\" AND disabled:false)"},
    {"id": "Q03", "purpose": "Identities created in the first half of 2026 (inclusive)", "query": "created:[2026-01-01 TO 2026-06-30]"},
    {"id": "Q04", "purpose": "Same dates, exclusive range", "query": "created:{2026-01-01 TO 2026-06-30}"},
    {"id": "Q05", "purpose": "Identities with no manager", "query": "NOT _exists_:manager.name"},
    {"id": "Q06", "purpose": "Privileged access outside IT", "query": "@access(privileged:true) AND NOT attributes.department:IT"},
    {"id": "Q07", "purpose": "Active Finance identities (typed in a hurry)", "query": "attributes.department:finance and status:ACTIVE"},
    {"id": "Q08", "purpose": "Cost centre 4410", "query": "attributes.costCenter:4410"},
    {"id": "Q09", "purpose": "Marketing staff", "query": "attributes.department:Marketing"},
    {"id": "Q10", "purpose": "Engineers in Austin (operator forgotten)", "query": "attributes.department:Engineering attributes.location:Austin"},
    {"id": "Q11", "purpose": "Accounts in Sao Paulo (bracket forgotten)", "query": "accountCount:>1 AND (attributes.location:\"Sao Paulo\""},
    {"id": "Q12", "purpose": "Joiners in the last 30 days", "query": "created:>=now-30d"}
  ],
