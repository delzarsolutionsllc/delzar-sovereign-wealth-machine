    {
      "id": "RFC-2026-0431",
      "title": "Disable SMBv1 on file-server",
      "requested_by": "sec_architect",
      "approvals": ["cab_chair", "ops_lead"],
      "target_systems": ["file-server"],
      "window": { "start": "2026-11-27T01:00:00", "end": "2026-11-27T02:00:00" },
      "estimated_minutes": 15,
      "tested_in_staging": true,
      "emergency": false,
      "change_steps": [
        { "step": 1, "action": "snapshot",      "target": "file-server" },
        { "step": 2, "action": "config_change", "target": "file-server", "setting": "Set-SmbServerConfiguration -EnableSMB1Protocol $false", "effects": ["disable:smbv1"] }
      ],
      "firewall_changes": { "allow": [], "deny": [] },
      "backout_plan": {
        "estimated_minutes": 10,
        "steps": [ { "undo_of": 2, "action": "restart_service" } ],
        "verification": ["map \\\\file-server\\share from a workstation"]
      }
    }
  ]
