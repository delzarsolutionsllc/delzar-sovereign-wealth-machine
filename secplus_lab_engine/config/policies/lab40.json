    "outcome_definitions": {
      "ACCESS_GRANTED": "Both policies allow the sign-in and one factor type is enough.",
      "MFA_REQUIRED_SATISFIED": "Both policies allow the sign-in, two factor types were required and the user presented them.",
      "DENIED_BY_GLOBAL_SESSION_POLICY": "The global session policy rule that matched (or the lack of one) denies the Okta session.",
      "DENIED_BY_AUTHENTICATION_POLICY": "The app's authentication policy rule that matched denies access to the app.",
      "DENIED_BLOCKED_ZONE": "The request comes from an active blocklist network zone and is rejected before authentication.",
      "ENROLLMENT_REQUIRED": "The user must enroll an authenticator the enrollment policy allows before access completes.",
      "INSUFFICIENT_AUTHENTICATORS": "The authenticators presented do not meet the combined policy requirements."
    },
    "concepts": {
      "network zone": "A named set of IP ranges, or of locations, ASNs and anonymizer types, that policy rules and blocklists refer to.",
      "blocklist zone": "A network zone whose requests Okta rejects before any authentication or policy rule is evaluated.",
      "dynamic zone": "A network zone defined by country or region, autonomous system number (ASN) or proxy and anonymizer type instead of fixed IP ranges.",
      "global session policy": "The org-level policy, assigned to groups, that decides whether an Okta session may be created, with which primary factor, whether MFA is needed and how long the session lasts.",
      "authentication policy": "The policy attached to one or more apps that decides, per sign-in context, whether the user may open that app and with what assurance.",
      "authenticator enrollment policy": "The policy, assigned to groups, that sets each authenticator as required, optional or disabled for enrollment.",
      "catch-all rule": "The lowest-priority rule of a policy that matches every request no other rule matched.",
      "possession factor constraint": "An authentication policy setting that only lets possession authenticators with chosen properties, such as phishing resistance or hardware protection, count."
    }
