      "phishing_email":            { "vector": "Message-based: email phishing", "mitigation": "Email gateway with DMARC enforcement + security awareness training" },
      "sms_link":                  { "vector": "Message-based: SMS (smishing)", "mitigation": "Mobile threat defense + awareness training on SMS links" },
      "phone_call_helpdesk":       { "vector": "Voice call (vishing / pretexting)", "mitigation": "Help-desk caller verification procedure before any reset" },
      "usb_drop":                  { "vector": "Removable device", "mitigation": "Disable USB mass storage + application allow list" },
      "vendor_update_compromised": { "vector": "Supply chain: software vendor", "mitigation": "Vendor risk management + code-signing/SBOM verification" },
      "unpatched_public_service":  { "vector": "Vulnerable software / open service port", "mitigation": "Patch management + reduce exposed attack surface" },
      "default_credentials":       { "vector": "Default credentials", "mitigation": "Hardening: change default credentials, disable unused accounts" },
      "rogue_access_point":        { "vector": "Unsecure network: wireless", "mitigation": "802.1X/WPA3-Enterprise + wireless IDS for rogue APs" },
      "valid_internal_account":    { "vector": "Valid account / authorized access", "mitigation": "Least privilege + separation of duties + UEBA monitoring" },
      "unsanctioned_saas":         { "vector": "Unsanctioned cloud service", "mitigation": "CASB discovery/blocking + acceptable use policy" }
    },
    "actor_addons": {
      "Nation-state": "Assume persistence: threat hunting, segmentation, and intel sharing (ISAC)",
      "Organized crime": "Offline/immutable backups and an extortion response plan",
      "Hacktivist": "DDoS protection and monitoring of public-facing assets",
      "Insider threat": "Offboarding/JML hygiene and data loss prevention",
      "Unskilled attacker": "Basic hygiene closes most of the doors (patching, defaults, MFA)",
      "Shadow IT": "Give people a sanctioned alternative so they stop working around IT"
    }
  },

  "resilience": {
    "site_types": {
      "hot":  { "rto_hours": 1,   "annual_cost": 500000, "desc": "fully equipped, data replicated, ready to run" },
      "warm": { "rto_hours": 24,  "annual_cost": 150000, "desc": "hardware and network ready, data must be restored" },
      "cold": { "rto_hours": 168, "annual_cost": 40000,  "desc": "space and power only; equipment must be procured and installed" }
    },
    "replication": {
